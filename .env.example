DATABASE_URL=postgresql://catamotive:replace-me@127.0.0.1:55439/catamotive
APP_ORIGIN=http://127.0.0.1:3000
# APP_ORIGINS=https://autre-domaine-autorise.example
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local/uploads
# Production Supabase Storage via its S3-compatible endpoint:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=catamotive-private
# Separate private bucket with a 50 MB server-side file size limit for browser uploads.
# S3_UPLOAD_BUCKET=catamotive-uploads
# The app accepts 50 MB by default. Lower this to 5 MiB only if your bucket
# cannot accept 50 MB, or use a storage service tested with larger objects.
# UPLOAD_MAX_BYTES=5242880
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Local HTTP only. Use true with HTTPS when deployment has been hardened.
COOKIE_SECURE=false
# Required for the daily retention job on Vercel.
CRON_SECRET=replace-with-at-least-32-random-characters
