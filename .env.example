DATABASE_URL=postgresql://catamotive:replace-me@127.0.0.1:55439/catamotive
# Production (Neon): DATABASE_URL = pooled URL (host contains "-pooler"),
# DATABASE_URL_UNPOOLED = direct URL, used only by `npm run db:migrate`.
# channel_binding is removed and sslmode=require becomes verify-full automatically;
# poolers (Neon -pooler, port 6543) get prepare:false and one connection per instance.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
APP_ORIGIN=http://127.0.0.1:3000
# APP_ORIGINS=https://autre-domaine-autorise.example
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local/uploads
# Production object storage, any S3-compatible service (Backblaze B2 recommended):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_BUCKET=catamotive-private
# Separate private bucket for browser uploads (CORS: GET, HEAD, PUT from APP_ORIGIN).
# S3_UPLOAD_BUCKET=catamotive-uploads
# The app accepts 50 MB by default. Lower this to 5 MiB only if your bucket
# cannot accept 50 MB, or use a storage service tested with larger objects.
# UPLOAD_MAX_BYTES=5242880
# Up to 200 MB was validated on B2; keep 50 MB if the daily download quota is tight:
# UPLOAD_MAX_BYTES=200000000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Local HTTP only. Use true with HTTPS when deployment has been hardened.
COOKIE_SECURE=false
# Export direct Shopify / WooCommerce (docs/integration/CONNECTEURS_CMS.md).
# Chiffre les clés des boutiques connectées : openssl rand -base64 32
# STORE_CREDENTIALS_KEY=
# Required for the daily retention job on Vercel.
CRON_SECRET=replace-with-at-least-32-random-characters

# --- Couche d'intégration (docs/integration/) ---------------------------------
# inline (défaut, comportement du pilote Vercel) ou queue (outbox + RabbitMQ).
# JOB_DISPATCH=queue
# RABBITMQ_URL=amqp://catamotive:catamotive-lab-only@127.0.0.1:5672/catamotive
# SSO OIDC (Keycloak ou WSO2 Identity Server) ; active aussi l'API publique /api/v1.
# OIDC_ISSUER=http://keycloak:8080/realms/catamotive
# OIDC_CLIENT_ID=catamotive-web
# OIDC_CLIENT_SECRET=catamotive-web-secret-lab-only
# OIDC_API_AUDIENCE=catamotive-api
# Auth0 + Google (docs/integration/AUTH0.md)
# OIDC_ISSUER=https://votre-tenant.eu.auth0.com/
# OIDC_SOCIAL_CONNECTIONS=google-oauth2:Google
# OIDC_GROUPS_CLAIM=https://catamotive.app/groups   # seulement avec l'Action Auth0
# OIDC_SELF_SIGNUP=false                            # désactive l'inscription par SSO
# OIDC_CONNECTION_PARAM=kc_idp_hint                 # Keycloak ; fidp pour WSO2

# --- Paiement Stripe et quotas par offre (docs/PAIEMENT.md) --------------------
# Les quotas s'appliquent dès que la clé et les trois prix sont présents.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_AUTOMATIC_TAX=true          # seulement si Stripe Tax est configuré
# QUOTAS_ENFORCED=true               # force les quotas sans Stripe ; false les coupe

# --- Emails transactionnels (vérification, mot de passe oublié, invitations) ---
# log (défaut) : affiche les emails dans la console en développement ;
# en production, sans driver configuré, l'envoi est refusé (503).
# MAIL_DRIVER=resend
# RESEND_API_KEY=re_xxx
# MAIL_FROM="CataMotive <no-reply@votre-domaine.fr>"
